# Jarvis Configuration
# Copy to .env and fill in your values

# ============================================
# Google OAuth (for Gmail + Calendar)
# Get from: https://console.cloud.google.com/apis/credentials
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret
GOOGLE_PROJECT_ID=your_project_id

# ============================================
# GitHub Personal Access Token
# Get from: https://github.com/settings/tokens
# Scopes: repo, workflow, admin:repo_hook
# ============================================
GITHUB_TOKEN=ghp_your_github_token

# ============================================
# Plaid (for bank/finance sync) - Optional
# Get from: https://dashboard.plaid.com/team/keys
# Environments: sandbox, development, production
# ============================================
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# ============================================
# Secrets Encryption Password
# IMPORTANT: Use a strong unique password!
# This encrypts all stored OAuth tokens, API keys, etc.
# ============================================
JARVIS_SECRETS_PASSWORD=your-very-strong-password-here-min-32-chars

# ============================================
# Optional: Default Settings
# ============================================
JARVIS_DEBUG=false
JARVIS_LOG_LEVEL=INFO
JARVIS_TIMEZONE=America/New_York
JARVIS_DATA_DIR=~/.jarvis